// Faculty AI Changemaker Teams: Research AI Engineers embedded in faculties, coordinated through ARC.
graph fact {
    graph [bgcolor="#3c1657", layout="neato", pad="0.3"];
    node  [shape="box", style="filled,rounded", fillcolor="#f5f5f5", fontcolor="#3c1657",
           color="#a433ff", penwidth="2", fontname="Helvetica", fontsize="22", margin="0.25,0.15"];
    edge  [color="#a433ff", penwidth="3", len="2.4"];

    arc [label="UCL ARC\nplatforms · community of practice ·\ndeep expertise · cost recovery",
         fillcolor="#a433ff", fontcolor="#f5f5f5", color="#f5f5f5", penwidth="3", fontsize="22", pos="0,0!"];
    maps [label="Mathematical &\nPhysical Sciences\n(pathfinder: recruiting now)", pos="-2.8,2.1!"];
    fls  [label="Life Sciences\n(next)", pos="2.8,2.1!"];
    more1 [label="Further faculties", fillcolor="#3c1657", fontcolor="#f5f5f5", style="rounded,dashed", pos="-2.6,-1.9!"];
    more2 [label="Further faculties", fillcolor="#3c1657", fontcolor="#f5f5f5", style="rounded,dashed", pos="2.6,-1.9!"];

    arc -- maps; arc -- fls;
    arc -- more1 [style="dashed"]; arc -- more2 [style="dashed"];
}
