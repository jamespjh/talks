// The research technology professions, with the new one lit up.
graph professions {
    graph [bgcolor="#3c1657", layout="neato", pad="0.3"];
    node  [shape="box", style="filled,rounded", fillcolor="#5b3a78", fontcolor="#e6dcef",
           color="#9c88ad", penwidth="2", fontname="Helvetica", fontsize="28", margin="0.3,0.2", width="3.6", height="1.1"];
    edge  [color="#9c88ad", penwidth="2"];

    rse [label="Research Software\nEngineers", pos="-3.6,1.5!"];
    rie [label="Research Infrastructure\nEngineers", width="4.4", pos="0,2.9!"];
    steward [label="Data Stewards", pos="3.6,1.5!"];
    scientist [label="Data Scientists", pos="-3.1,-1.7!"];
    raie [label="Research AI\nEngineers", fillcolor="#a433ff", fontcolor="#f5f5f5", color="#f5f5f5",
          penwidth="6", fontsize="40", width="4.6", height="1.7", pos="3.0,-1.9!"];
    research [label="Trustworthy\nresearch", shape="ellipse", style="filled", fillcolor="#f5f5f5",
              fontcolor="#3c1657", color="#a433ff", fontsize="22", width="2.4", height="1.3", pos="0,0!"];

    research -- rse; research -- rie; research -- steward; research -- scientist;
    research -- raie [color="#f5f5f5", penwidth="6"];
}
