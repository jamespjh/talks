// What a digital research technology platform does: four activities that feed each other (after the inaugural lecture's arc.dot).
digraph arc {
    graph [bgcolor="#3c1657", layout="neato", pad="0.3"];
    node  [shape="box", style="filled,rounded", fillcolor="#f5f5f5", fontcolor="#3c1657",
           color="#a433ff", penwidth="2", fontname="Helvetica", fontsize="20", margin="0.25,0.15"];
    edge  [color="#a433ff", penwidth="2", arrowsize="0.8", dir="both"];

    platforms [label="Compute and data\nplatforms", pos="0,-2!"];
    consulting [label="Research software\nengineering & consulting", pos="3.4,0!"];
    rnd [label="R&D in digital\nresearch methods", pos="0,2!"];
    education [label="Digital research\neducation", pos="-3.4,0!"];

    platforms -> consulting -> rnd -> education -> platforms;
    platforms -> rnd;
    consulting -> education;
}
