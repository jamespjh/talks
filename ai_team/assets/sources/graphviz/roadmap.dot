// Four strands of the AI team's roadmap. Status colours: done = light purple fill,
// in progress = white fill, next = outline only.
digraph roadmap {
    graph [bgcolor="#3c1657", rankdir="LR", nodesep="0.35", ranksep="0.6", pad="0.3",
           fontname="Helvetica", fontcolor="#f5f5f5"];
    node  [shape="box", style="filled,rounded", fillcolor="#f5f5f5", fontcolor="#3c1657",
           color="#a433ff", penwidth="2", fontname="Helvetica", fontsize="15", margin="0.18,0.1", width="2.6"];
    edge  [color="#a433ff", penwidth="2", arrowsize="0.7"];

    // column headings
    node [shape="plaintext", style="", fontcolor="#f5f5f5", fontsize="16", width="0"];
    h0 [label=""]; h1 [label="Done"]; h2 [label="Now"]; h3 [label="Next"];
    h0 -> h1 -> h2 -> h3 [style="invis"];

    // strand labels
    node [shape="plaintext", style="", fontcolor="#f5f5f5", fontsize="17", width="0"];
    s1 [label="University AI capability"];
    s2 [label="Mixed tokenomics strategy"];
    s3 [label="MCP & RAG"];
    s4 [label="Governance"];

    node [shape="box", style="filled,rounded", fontsize="15", width="2.6"];

    // done
    node [fillcolor="#a433ff", fontcolor="#f5f5f5", color="#f5f5f5"];
    d1 [label="Shop and Foundry\nRFI completed"];
    d2 [label="LiteLLM + vLLM\nlive on Condenser"];
    d3 [label="Early MCP\n& RAG tests"];
    d4 [label="Structure\napproved"];

    // in progress
    node [fillcolor="#f5f5f5", fontcolor="#3c1657", color="#a433ff"];
    p1 [label="Provider agreements;\nFoundry pilot"];
    p2 [label="Gateway evaluation;\nmore models"];
    p3 [label="Jira · MyServices\n· UCL policies"];
    p4 [label="Standing up\nthe new groups"];

    // next
    node [fillcolor="#3c1657", fontcolor="#f5f5f5", color="#a433ff", style="rounded,dashed"];
    n1 [label="Select long-term\nplatform"];
    n2 [label="Quotas & cost\nattribution"];
    n3 [label="Managed MCP registry\n& knowledge service"];
    n4 [label="AI leads &\nuse-case library"];

    s1 -> d1 -> p1 -> n1;
    s2 -> d2 -> p2 -> n2;
    s3 -> d3 -> p3 -> n3;
    s4 -> d4 -> p4 -> n4;
    // invisible links within each column fix the top-to-bottom order
    edge [style="invis"];
    h0 -> s1 -> s2 -> s3 -> s4;
    h1 -> d1 -> d2 -> d3 -> d4;
    h2 -> p1 -> p2 -> p3 -> p4;
    h3 -> n1 -> n2 -> n3 -> n4;
    edge [style=""];

    { rank="same"; h0; s1; s2; s3; s4; }
    { rank="same"; h1; d1; d2; d3; d4; }
    { rank="same"; h2; p1; p2; p3; p4; }
    { rank="same"; h3; n1; n2; n3; n4; }
}
