// The same shape as agent.dot, filled in with the pieces the UCL AI team is building.
// Roles match agent.dot so the same highlighting applies (agent_ucl_<role>.svg).
// Product names are logos (IMG); ../logos.py inlines them with hover tooltips, so embed
// the rendered SVG with <object>, not <img>.
digraph agent_ucl {
    graph [bgcolor="#3c1657", rankdir="TB", nodesep="0.35", ranksep="0.55", pad="0.2",
           fontname="Helvetica", fontcolor="#f5f5f5"];
    node  [shape="box", style="filled,rounded", fillcolor="#f5f5f5", fontcolor="#3c1657",
           color="#a433ff", penwidth="2", fontname="Helvetica", fontsize="17", margin="0.2,0.1"];
    edge  [color="#a433ff", penwidth="2", arrowsize="0.8", dir="both"];

    you        [role="you",      label="UCL staff\n& students", shape="ellipse"];
    harness    [role="harness",  label=<<TABLE BORDER="0" CELLSPACING="3" CELLPADDING="0"><TR><TD>AI@UCL Foundry</TD><TD><IMG SRC="logos-sized/airia.svg"/></TD></TR></TABLE>>, fontsize="19", width="2.7"];
    claude     [role="harness",  label=<<TABLE BORDER="0" CELLSPACING="3" CELLPADDING="0"><TR><TD><IMG SRC="logos-sized/claude.svg"/></TD><TD>apps</TD><TD><FONT POINT-SIZE="14">(used directly)</FONT></TD></TR></TABLE>>, fontsize="19", width="2.7"];
    gateway    [role="platform", label=<<TABLE BORDER="0" CELLSPACING="3" CELLPADDING="0"><TR><TD><IMG SRC="logos-sized/litellm.svg"/></TD><TD>gateway<BR/><FONT POINT-SIZE="13">keys · quotas · usage · routing</FONT></TD></TR></TABLE>>];
    vllm       [role="platform", label=<<TABLE BORDER="0" CELLSPACING="3" CELLPADDING="0"><TR><TD><IMG SRC="logos-sized/vllm.svg"/></TD><TD>on Condenser GPUs</TD></TR></TABLE>>];
    local      [role="model",    label=<<TABLE BORDER="0" CELLSPACING="3" CELLPADDING="0"><TR><TD><IMG SRC="logos-sized/meta.svg"/></TD><TD><IMG SRC="logos-sized/mistralai.svg"/></TD><TD><IMG SRC="logos-sized/qwen.svg"/></TD><TD><FONT POINT-SIZE="14">UCL-hosted</FONT></TD></TR></TABLE>>];
    commercial [role="model",    label=<<TABLE BORDER="0" CELLSPACING="3" CELLPADDING="0"><TR><TD><IMG SRC="logos-sized/anthropic.svg"/></TD><TD><IMG SRC="logos-sized/openai.svg"/></TD><TD><IMG SRC="logos-sized/googlegemini.svg"/></TD><TD><FONT POINT-SIZE="14">enterprise agreements</FONT></TD></TR></TABLE>>];
    mcp        [role="tools",    label=<<TABLE BORDER="0" CELLSPACING="3" CELLPADDING="0"><TR><TD><IMG SRC="logos-sized/modelcontextprotocol.svg"/></TD><TD>servers</TD></TR></TABLE>>];
    jira       [role="tools",    label=<<TABLE BORDER="0" CELLSPACING="3" CELLPADDING="0"><TR><TD><IMG SRC="logos-sized/jira.svg"/></TD></TR></TABLE>>, shape="cds", margin="0.3,0.1"];
    myserv     [role="tools",    label=<<TABLE BORDER="0" CELLSPACING="3" CELLPADDING="0"><TR><TD><IMG SRC="logos-sized/myservices.svg"/></TD></TR></TABLE>>, shape="cds", margin="0.3,0.1"];
    policies   [role="tools",    label="UCL policies\n(RAG)", shape="cylinder"];

    you -> harness;
    you -> claude;
    harness -> gateway [role="platform"];
    gateway -> vllm [role="platform"];
    vllm -> local [role="model"];
    gateway -> commercial [role="model"];
    // not everything goes through the gateway: some Foundry calls, and the Claude apps, go straight to the provider
    harness -> commercial [role="model"];
    claude -> commercial [role="model"];
    harness -> mcp [role="tools"];
    claude -> mcp [role="tools"];
    mcp -> jira [role="tools"];
    mcp -> myserv [role="tools"];
    mcp -> policies [role="tools"];

    { rank="same"; gateway; mcp; }
    { rank="same"; harness; claude; }
}
